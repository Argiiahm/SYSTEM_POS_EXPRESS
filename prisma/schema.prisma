generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  waiter
  admin
  finance
  foodKitchen // Dapur Makanan
  beverageStation // Dapur Minuman
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique
  telp  String @unique

  password      String
  role          Role           @default(waiter)
  refreshTokens refreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model refreshToken {
  id String @id

  tokenHash String
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
